# ── Database ──
DATABASE_URI=postgresql://payload:payload_secret@localhost:5432/payload

# ── Payload ──
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Cloudflare R2 (Media Storage) ──
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=payload-media
S3_REGION=auto

# ── Email (Resend) ──
RESEND_API_KEY=

# ── ISR Revalidation ──
REVALIDATE_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# ── Development ──
# Set a default tenant for local development
DEFAULT_TENANT_SLUG=ghee-roast
