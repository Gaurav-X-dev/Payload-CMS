# ── Database ──
DATABASE_URI=

# ── Payload ──
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Cloudflare R2 (Media Storage) ──
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=payload-media
S3_REGION=auto

# ── Email (tenant-managed SMTP) ──
# SMTP host/port/credentials/from-address are configured per tenant in Payload Admin
# (EmailSettings), not here. This is the ONLY mail-related secret that stays server-side: the
# master key used to encrypt/decrypt each tenant's stored SMTP password (AES-256-GCM). It is
# never stored in Payload, never returned by any API response, and never logged.
MAIL_SETTINGS_ENCRYPTION_KEY=
# Optional. Only needed if NEXT_PUBLIC_SERVER_URL itself isn't publicly reachable (e.g. it's
# still localhost) but you have a separate public base for outbound assets — a CDN, a dev
# tunnel (ngrok/Cloudflare Tunnel), etc. Used only to build the tenant logo URL embedded in
# outgoing email. Leave empty to use NEXT_PUBLIC_SERVER_URL, or (in local dev, when neither is
# public) fall back to embedding the tenant's real logo directly in the email as a data URI.
PUBLIC_EMAIL_ASSET_BASE_URL=

# ── ISR Revalidation ──
REVALIDATE_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# ── Development ──
# Set a default tenant for local development
DEFAULT_TENANT_SLUG=ghee-roast
# Disable demo Header/Hero fallbacks for a genuinely empty CMS start.
# Set to true only when the static Ghee Roast fallback is intentionally wanted.
ENABLE_GHEE_ROAST_LEGACY_FALLBACKS=false

# ── Controlled development seed ──
# Required by: npm run db:seed:dev
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

SEED_TENANT_DOMAIN=
SEED_TENANT_USER_NAME=
SEED_TENANT_USER_EMAIL=
SEED_TENANT_USER_PASSWORD=
