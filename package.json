{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint src tests scripts next.config.mjs eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "payload": "payload",
    "payload:generate-importmap": "payload generate:importmap",
    "db:reset:dev": "node --env-file=.env --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/reset-development-data.ts",
    "db:seed:dev": "node --env-file=.env --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/seed-development-data.ts",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:phase1": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/phase1-tenant-access.test.ts",
    "test:phase2": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/phase2-relationship-integrity.test.ts",
    "test:authorization": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/authorization-validation.test.ts",
    "test:development-content": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/development-content.test.ts",
    "test:ghee-cms": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/ghee-roast-cms.test.ts tests/ghee-roast-forms.test.ts tests/ghee-roast-hostname.test.ts tests/ghee-roast-loader.test.ts tests/ghee-roast-routing.test.ts",
    "test": "npm run test:authorization && npm run test:phase1 && npm run test:phase2 && npm run test:development-content && npm run test:ghee-cms",
    "test:security": "npm run test:security:serial",
    "test:security:serial": "node --env-file=.env --experimental-strip-types --import ./tests/register-ts-loader.mjs --test --test-concurrency=1 tests/security/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-s3": "^3.86.0",
    "@phosphor-icons/react": "^2.1.10",
    "graphql": "^16.14.2",
    "next": "^16.2.11",
    "payload": "^3.86.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "typescript": "6.0.3"
  }
}
